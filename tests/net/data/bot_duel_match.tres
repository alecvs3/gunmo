[ext_resource type="Resource" path="res://bots/profiles/normal.tres" id="7_normal"]

[resource]
script = ExtResource("1_match")
map = ExtResource("90_map")
mode_scene = ExtResource("2_mode")
bot_fill_to = 2
ladder = Array[ExtResource("4_wdata")]([ExtResource("3_smg")])
kills_per_tier = 50
final_tier_kills = 50
respawn_seconds = 0.5
spawn_protection_seconds = 0.5
bot_profiles = Array[ExtResource("5_profile")]([ExtResource("6_hard"), ExtResource("7_normal")])
