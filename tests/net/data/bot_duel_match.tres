[gd_resource type="Resource" script_class="MatchSettings" format=3]

[ext_resource type="Resource" path="res://levels/data/outpost.tres" id="90_map"]
[ext_resource type="Script" path="res://modes/match_settings.gd" id="1_match"]
[ext_resource type="PackedScene" path="res://modes/gun_game/gun_game_mode.tscn" id="2_mode"]
[ext_resource type="Resource" path="res://weapons/data/smg.tres" id="3_smg"]
[ext_resource type="Script" path="res://weapons/weapon_data.gd" id="4_wdata"]
[ext_resource type="Script" path="res://bots/bot_profile.gd" id="5_profile"]
