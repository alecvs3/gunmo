[gd_resource type="Resource" script_class="NetworkConfig" format=3]

[ext_resource type="Script" path="res://shared/network/network_config.gd" id="1_netcfg"]

[resource]
script = ExtResource("1_netcfg")
default_port = 7777
max_players = 8
require_matching_build = true
join_timeout = 8.0
auth_timeout = 3.0
peer_timeout_factor = 32
peer_timeout_min_ms = 3000
peer_timeout_max_ms = 8000
close_flush_time = 0.25
ping_interval = 1.0
ping_good_ms = 80
ping_ok_ms = 150
snapshot_interval_ticks = 2
max_snapshot_bytes = 1100
interpolation_delay = 0.1
clock_snap_ticks = 10.0
clock_correction = 0.1
command_redundancy = 4
command_budget = 4
max_commands_per_tick = 2
max_pending_commands = 16
prediction_snap_distance = 120.0
prediction_error_decay = 15.0
max_rewind = 0.25
sim_latency_ms = 0
sim_jitter_ms = 0
sim_loss = 0.0
