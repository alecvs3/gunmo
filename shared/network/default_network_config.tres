[gd_resource type="Resource" script_class="NetworkConfig" format=3]

[ext_resource type="Script" path="res://shared/network/network_config.gd" id="1_netcfg"]

[resource]
script = ExtResource("1_netcfg")
default_port = 7777
max_players = 8
require_matching_build = true
join_timeout = 8.0
auth_timeout = 3.0
peer_timeout_factor = 32
peer_timeout_min_ms = 3000
peer_timeout_max_ms = 8000
close_flush_time = 0.25
ping_interval = 1.0
ping_good_ms = 80
ping_ok_ms = 150
snapshot_interval_ticks = 1
max_snapshot_bytes = 1100
interpolation_delay = 0.1
min_interpolation_delay = 0.035
max_interpolation_delay = 0.25
jitter_scale = 1.25
smoothing_margin = 0.008
delay_raise_rate = 0.15
delay_lower_rate = 0.02
dry_boost_decay = 0.05
local_stall_seconds = 0.1
clock_snap_ticks = 10.0
clock_correction = 0.1
command_redundancy = 4
command_budget = 4
max_commands_per_tick = 2
max_pending_commands = 16
max_input_buffer_ticks = 2
stalls_to_grow_buffer = 2
buffer_grow_window = 2.0
buffer_calm_time = 5.0
prediction_snap_distance = 120.0
prediction_error_decay = 15.0
max_rewind = 0.25
host_view_delay_ticks = 2
command_packets_per_second = 120.0
command_burst = 40.0
requests_per_second = 8.0
request_burst = 16.0
max_request_bytes = 64
hiccup_seconds = 0.25
sim_latency_ms = 0
sim_jitter_ms = 0
sim_loss = 0.0
