[sub_resource type="Resource" id="Tier_1"]
script = ExtResource("2_tier")
display_name = "Arc Spark"
description = "A hit has a 15% chance (at most once a second) to arc blue lightning to 2 enemies within 140 px, for 40% of the hit's damage."
price = 200

[sub_resource type="Resource" id="Tier_2"]
script = ExtResource("2_tier")
display_name = "Frost Rune"
description = "Every 8 s a rune lands where enemies are thickest near you: 35% slower for 3 s. Arc Spark: 20%, 3 jumps."
price = 400

[sub_resource type="Resource" id="Tier_3"]
script = ExtResource("2_tier")
display_name = "Conduction"
description = "Slowed enemies take 25% more lightning damage, and arcs from them jump once more."
price = 700

[sub_resource type="Resource" id="Tier_4"]
script = ExtResource("2_tier")
display_name = "Hex"
description = "Every 12 s it marks the toughest enemy in sight: +20% damage from everyone for 5 s, and arcs always start from it. Runes every 6 s."
price = 1100

[sub_resource type="Resource" id="Tier_5"]
script = ExtResource("2_tier")
display_name = "Tempest"
description = "Every 25 s, after a 1 s warning, 6 bolts strike enemies for 8% of their max health (2% on bosses). Hex every 7 s."
price = 1600

